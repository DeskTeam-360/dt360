# www.deskteam360.com → https://deskteam360.com (preserve path + query)
# Applied by scripts/apply-www-apex-redirect.sh on the origin host.
# Do not serve app content or the nginx placeholder on this host.

server {
    listen 80;
    listen [::]:80;
    server_name www.deskteam360.com;
    return 301 https://deskteam360.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.deskteam360.com;

    ssl_certificate     __SSL_CERTIFICATE__;
    ssl_certificate_key __SSL_CERTIFICATE_KEY__;

    # Prefer 308 so method/body are preserved on HTTPS→HTTPS.
    return 308 https://deskteam360.com$request_uri;
}
